# ==============================================================================
# HelpHun — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real API keys, secrets, or service account credentials to Git.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Firebase Client SDK (Safe for Client-Side Bundling)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=helphun-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=helphun-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=helphun-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK (SERVER-SIDE ONLY — Keep Strictly Secret)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console > Project Settings > Service Accounts
FIREBASE_ADMIN_PROJECT_ID=helphun-app
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@helphun-app.iam.gserviceaccount.com
# Note: In .env.local, replace actual line breaks with \n in the private key string
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. Google Gemini AI API (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Used for intelligent job categorization, wage estimation, and skill extraction
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Surepass KYC Verification API (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Used for Aadhaar OTP and PAN verification of Indian workers
# Sandbox endpoint: https://sandbox.surepass.io/api/v1
# Production endpoint: https://kyc.surepass.io/api/v1
SUREPASS_BASE_URL=https://sandbox.surepass.io/api/v1
SUREPASS_API_TOKEN=your_surepass_bearer_token_here
SUREPASS_SANDBOX_MODE=true

# ------------------------------------------------------------------------------
# 5. Razorpay Payment Gateway & Payouts (India)
# ------------------------------------------------------------------------------
# Test mode keys start with 'rzp_test_', live keys start with 'rzp_live_'
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# RazorpayX Payouts for Worker UPI Withdrawals
RAZORPAYX_ACCOUNT_NUMBER=2323230000000000
RAZORPAYX_SANDBOX_MODE=true

# ------------------------------------------------------------------------------
# 6. Map & Geolocation Provider
# ------------------------------------------------------------------------------
# Options: 'osm' (OpenStreetMap, no key required), 'google', 'mapbox'
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAP_API_KEY=
